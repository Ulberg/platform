<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Parse.fs" />
    <Compile Include="People.fs" />
    <Compile Include="Desired.fs" />
    <Compile Include="Codeowners.fs" />
    <Compile Include="Entra.fs" />
    <Compile Include="AzureRbac.fs" />
    <Compile Include="GitHub.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Pulumi" Version="3.116.2" />
    <PackageReference Include="Pulumi.FSharp" Version="3.116.2" />
    <PackageReference Include="Pulumi.AzureAD" Version="6.11.2" />
    <PackageReference Include="Pulumi.AzureNative" Version="3.30.0" />
    <PackageReference Include="Pulumi.Github" Version="6.15.1" />
    <PackageReference Include="FsToolkit.ErrorHandling" Version="5.2.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <!-- Pulumi pulls in OpenTelemetry 1.9.0, which has known vulnerabilities. Pin the fixed versions. -->
    <PackageReference Include="OpenTelemetry.Api" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
  </ItemGroup>
</Project>
