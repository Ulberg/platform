#!/usr/bin/env bash
# The platform CLI (D63): sets up the local platform (D61) and runs an app in it.
#
#   platform up   <app repo>   a fresh cluster with the platform, the app's database, and the app
#   platform sync <app repo>   hands Argo CD the checkouts as they are now (platform.yaml, environments,
#                              components, the renderer), rebuilds the services' dev images if their packages
#                              changed, and waits until everything has rolled out
#   platform test <app repo>   checks the network rules against the running cluster (D66)
#   platform down <app repo>   removes the cluster and the database
#
# It only bootstraps (D67): kind, Cilium, the git server, Argo CD and its root application. Argo CD then deploys
# everything else from the platform repo, exactly as in Azure: the platform components and the app, rendered by
# the renderer running inside Argo CD (D68). Code changes reach the app's pods by hot reload, without Argo CD.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
platform_root=$(cd "$here/.." && pwd)
# shellcheck source=versions.env
source "$here/versions.env"
# Inside the CLI image (D63), the release names the renderer image to run (RENDERER_IMAGE, PLATFORM_VERSION);
# from a checkout of the platform repo, the renderer is built from it.
[ -f "$here/release.env" ] && source "$here/release.env"

usage="usage: platform up|sync|test|down <app repo>"
command=${1:?$usage}
app_repo=$(cd "${2:?$usage}" && pwd)
[ -f "$app_repo/platform.yaml" ] || { echo "No platform.yaml in $app_repo" >&2; exit 1; }

state="$app_repo/.local"
wait=2m # how long sync waits for everything to be ready; up waits longer
kubeconfig="$state/kubeconfig" # the developer's: the cluster at localhost
cli_kubeconfig=$kubeconfig     # the CLI's own; inside the image, the cluster by name (join_kind)
grafana=http://localhost:9876
renderer_image=platform/renderer:dev
platform_snapshot="$state/gitops/platform"
k() { kubectl --kubeconfig "$cli_kubeconfig" "$@"; }
h() { helm --kubeconfig "$cli_kubeconfig" "$@"; }
step() { printf '\n== %s\n' "$*"; }
# Git refuses a repository another user owns, and the checkouts are the developer's while the CLI's image runs as
# root (Docker Desktop hides that by showing shared files as root's; a Linux VM doesn't). Trusted: only the two repos
# this run was given (its own snapshots are root's).
git() { command git -c safe.directory="$app_repo" -c safe.directory="$platform_root" "$@"; }

# The renderer, from its image (the same one Argo CD's plugin runs), reading the platform's snapshot and the app
# repo read-only. Both are paths on the host, which the host's Docker can mount wherever the CLI runs.
render() {
  docker run --rm -v "$platform_snapshot:/platform:ro" -v "$app_repo:/app-repo:ro" "$renderer_image" "$@"
}

sha256() { (sha256sum "$1" 2>/dev/null || shasum -a 256 "$1") | cut -d' ' -f1; }

# The renderer image: inside the CLI image the release's, verified (D63); from a checkout, built from it.
# Prints "changed" if it differs from before (built without provenance, which is stamped anew on every build,
# so the image ID only changes with its content).
build_renderer() {
  local before after
  before=$(docker image inspect -f '{{.Id}}' "$renderer_image" 2>/dev/null || true)
  if [ -n "${RENDERER_IMAGE:-}" ]; then
    cosign verify "$RENDERER_IMAGE" --certificate-oidc-issuer https://token.actions.githubusercontent.com \
      --certificate-identity-regexp '^https://github\.com/Ulberg-Org/platform/\.github/workflows/release\.yml@refs/tags/v' \
      >/dev/null 2>&1 || { echo "The renderer image $RENDERER_IMAGE isn't signed by the platform's release" >&2; exit 1; }
    docker pull -q "$RENDERER_IMAGE" >/dev/null && docker tag "$RENDERER_IMAGE" "$renderer_image"
  else
    docker build -q --provenance=false -f "$platform_root/renderer/Dockerfile" -t "$renderer_image" "$platform_root" >/dev/null
  fi
  after=$(docker image inspect -f '{{.Id}}' "$renderer_image")
  [ "$before" = "$after" ] || echo changed
}

# Loads the renderer image into the cluster's nodes, or says why not. Pulled from the release, it's multi-arch, of
# which Docker only downloaded this machine's architecture; kind would export all of them, so it goes in as a
# one-architecture archive. (The services' images are built here, for this architecture only.)
load_renderer() { # image
  local archive="$state/image.tar" out
  docker save --platform "linux/$(docker version -f '{{.Server.Arch}}')" -o "$archive" "$1"
  out=$(kind load image-archive "$archive" --name "$cluster" 2>&1) || { echo "$out" >&2; rm -f "$archive"; exit 1; }
  rm -f "$archive"
  echo "$out"
}

# Inside the CLI image the cluster isn't at localhost: the CLI's container joins kind's Docker network and talks
# to the control plane and Grafana by name. From a checkout, nothing changes.
join_kind() {
  [ -f /.dockerenv ] || return 0
  docker network connect kind "$(hostname)" 2>/dev/null || true
  cli_kubeconfig="$state/kubeconfig-cli"
  kind get kubeconfig --internal --name "$cluster" >"$cli_kubeconfig"
  grafana="http://$cluster-control-plane:30876"
}

# What to build and create for the app (Render.plan), so the CLI never parses platform.yaml itself.
read_plan() {
  mkdir -p "$state"
  platform_commit=$(snapshot "$platform_root" platform)
  plan=$(render plan /app-repo/platform.yaml /platform/environments/local.yaml)
  app=$(jq -r .app <<<"$plan")
  cluster=$app
  # The CLI reaches the cluster's API by the node's name (join_kind), never through a proxy the machine may have.
  export NO_PROXY="${NO_PROXY:+$NO_PROXY,}$cluster-control-plane"
  export no_proxy=$NO_PROXY
}

# A source's files (NUL-separated) and where they come from: a checkout's tracked and new files, uncommitted
# changes included, or everything in the CLI image's copy of the platform.
files_of() {
  if git -C "$1" rev-parse 2>/dev/null; then
    git -C "$1" ls-files -z -co --exclude-standard | while IFS= read -r -d '' f; do [ -e "$1/$f" ] && printf '%s\0' "$f"; done
  else
    (cd "$1" && find . -type f ! -name release.env ! -path './.git/*' -print0)
  fi
}
origin_of() {
  if git -C "$1" rev-parse 2>/dev/null; then
    echo "$(git -C "$1" rev-parse --short HEAD)$(git -C "$1" diff --quiet HEAD -- || echo "-dirty")"
  else
    echo "release ${PLATFORM_VERSION:-unknown}"
  fi
}

# Commits a snapshot of a source (see files_of) to $state/gitops/<name>, which the git server serves to Argo CD
# (D68). Prints the commit.
snapshot() { # source name
  local source=$1 repo="$state/gitops/$2" from
  from=$(origin_of "$source")
  mkdir -p "$repo"
  [ -d "$repo/.git" ] || git -C "$repo" init -q -b main
  find "$repo" -mindepth 1 -maxdepth 1 ! -name .git -exec rm -rf {} +
  (cd "$source" && files_of "$source" | xargs -0 tar cf -) | tar xf - -C "$repo"
  git -C "$repo" add -A
  git -C "$repo" diff --cached --quiet ||
    git -C "$repo" -c user.name=platform -c user.email=platform@localhost -c commit.gpgsign=false \
      commit -q -m "Snapshot of $2 at $from"
  git -C "$repo" rev-parse HEAD
}

# Waits until Argo CD has compared both snapshots and everything is in sync and healthy, then until the app's
# services have rolled out (Argo CD's health can still read Healthy from before a change). Argo CD only runs a
# sync when something differs, so the compared revision is what tells that it has seen a snapshot. Gives up
# after $wait (2 minutes for sync; longer for up, which pulls and compiles everything) and says why.
synced() { # platform commit, app commit
  k -n argocd annotate applications --all argocd.argoproj.io/refresh=normal --overwrite >/dev/null
  ready "$1" "$2" >/dev/null 2>&1 || { not_ready; exit 1; }
  k -n argocd get applications --no-headers | awk '{print "Argo CD: " $1 " " $2 ", " $3}'
}

ready() { # platform commit, app commit
  k -n argocd wait application/platform --for=jsonpath="{.status.sync.revision}=$1" --timeout="$wait" &&
    k -n argocd wait "application/$app" --for=create --timeout="$wait" &&
    k -n argocd wait "application/$app" --for=jsonpath="{.status.sync.revision}=$2" --timeout="$wait" &&
    k -n argocd wait applications --all --for=jsonpath='{.status.sync.status}=Synced' --timeout="$wait" &&
    k -n argocd wait applications --all --for=jsonpath='{.status.health.status}=Healthy' --timeout="$wait" &&
    rolled_out
}

rolled_out() {
  local name
  for name in $(jq -r '.services[].name' <<<"$plan"); do
    k -n "$app" rollout status "deployment/$name" --timeout="$wait" || return 1
  done
}

# Why something isn't ready: the Argo CD applications that aren't synced and healthy, and the app's pods that
# aren't ready.
not_ready() {
  echo "Not ready after $wait:" >&2
  k -n argocd get applications --no-headers | awk '$2 != "Synced" || $3 != "Healthy" {print "  Argo CD: " $1 " " $2 ", " $3}' >&2
  failing_pods "$app"
}

# The pods in a namespace that aren't ready, each with its last log lines (of the crash before, if it restarted).
failing_pods() { # namespace
  local pod
  for pod in $(k -n "$1" get pods --no-headers | awk '{split($2, r, "/"); if (r[1] != r[2]) print $1}'); do
    echo "  $1/$pod, last lines:" >&2
    { k -n "$1" logs "$pod" --previous --tail=8 2>/dev/null || k -n "$1" logs "$pod" --tail=8 2>&1; } | sed 's/^/    /' >&2
  done
}

# A bootstrap step that waits for its pods: fails within its time, saying which pods and why (D61 speed).
installed() { # namespace, then the command
  local ns=$1
  shift
  "$@" >/dev/null 2>&1 || { echo "Not ready: $ns" >&2; failing_pods "$ns"; exit 1; }
}

# Claude's own Grafana account (D41 locally): a Viewer service account with a token in $state, which the app
# repo's .mcp.json hands to mcp-grafana. People sign in as admin; Claude only reads, and Grafana tells them apart.
grafana_for_claude() {
  local api=$grafana/api auth=admin:local-only-admin token="$state/grafana-claude-token" id
  until curl -sf -u "$auth" "$api/health" >/dev/null; do sleep 2; done
  [ -f "$token" ] && curl -sf -H "Authorization: Bearer $(cat "$token")" "$api/user" >/dev/null && return
  id=$(curl -sf -u "$auth" "$api/serviceaccounts/search?query=claude" | jq -r '.serviceAccounts[] | select(.name=="claude") | .id')
  [ -n "$id" ] || id=$(curl -sf -u "$auth" -H 'Content-Type: application/json' "$api/serviceaccounts" \
    -d '{"name":"claude","role":"Viewer"}' | jq -r .id)
  curl -sf -u "$auth" -H 'Content-Type: application/json' "$api/serviceaccounts/$id/tokens" \
    -d "{\"name\":\"mcp-$(date +%s)\"}" | jq -r .key >"$token"
  chmod 600 "$token"
}

# The network rules, checked against the running cluster (D66). Each check opens a TCP connection from a pod
# and expects it to connect or to be blocked; by IP address, so a blocked DNS lookup can't pass for a blocked
# connection. Probe pods run Argo CD's image (in the cluster already, with bash).
network_test() {
  local failed=0 probe_image kube_api git_ip collector_ip
  probe_image=$(k -n gitops get deployment git -o jsonpath='{.spec.template.spec.containers[0].image}')
  kube_api=$(k -n default get service kubernetes -o jsonpath='{.spec.clusterIP}')
  git_ip=$(k -n gitops get pods -o jsonpath='{.items[0].status.podIP}')
  collector_ip=$(k -n observability get pods -l app.kubernetes.io/name=opentelemetry-collector -o jsonpath='{.items[0].status.podIP}')

  connect() { echo "timeout 3 bash -c '</dev/tcp/$1/$2' 2>/dev/null"; } # ip port
  # check <allowed|blocked> <description> <command...>: runs the command, which connects or fails.
  check() {
    local want=$1 what=$2 got
    shift 2
    if "$@" >/dev/null 2>&1; then got=allowed; else got=blocked; fi
    if [ "$got" = "$want" ]; then printf '  ok    %-8s %s\n' "$got" "$what"
    else printf '  FAIL  %-8s %s (expected %s)\n' "$got" "$what" "$want"; failed=1; fi
  }
  from_service() { k -n "$app" exec "deployment/$1" -c "$1" -- bash -c "$(connect "$2" "$3")"; } # service ip port
  from_new_pod() { # namespace labels ip port: a fresh pod with only these labels
    k -n "$1" run "probe-$RANDOM" --image="$probe_image" --restart=Never --rm -i --quiet --labels="$2" \
      --command -- bash -c "$(connect "$3" "$4")"
  }

  local name database db db_ip host want ip port health
  for name in $(jq -r '.services[].name' <<<"$plan"); do
    database=$(jq -r --arg n "$name" '.services[] | select(.name == $n) | .database // empty' <<<"$plan")
    ip=$(k -n "$app" get pods -l "app.kubernetes.io/name=$name" -o jsonpath='{.items[0].status.podIP}')
    port=$(k -n "$app" get deployment "$name" -o jsonpath='{.spec.template.spec.containers[0].ports[0].containerPort}')
    health=$(k -n "$app" get deployment "$name" -o jsonpath='{.spec.template.spec.containers[0].readinessProbe.httpGet.port}')
    echo "$name"
    while read -r db host; do
      db_ip=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$host")
      [ "$db" = "$database" ] && want=allowed || want=blocked
      check "$want" "$name -> database $db" from_service "$name" "$db_ip" 5432
    done < <(jq -r '.databases[] | "\(.name) \(.host)"' <<<"$plan")
    check allowed "$name -> telemetry collector" from_service "$name" "$collector_ip" 4317
    check blocked "$name -> internet" from_service "$name" 1.1.1.1 443
    check blocked "$name -> Kubernetes API" from_service "$name" "$kube_api" 443
    check blocked "$name -> git server" from_service "$name" "$git_ip" 9418
    check allowed "gateway -> $name API port" from_new_pod gateway probe=gateway "$ip" "$port"
    check blocked "gateway -> $name health port" from_new_pod gateway probe=gateway "$ip" "$health"
    check blocked "unlabelled pod in $app -> $name" from_new_pod "$app" probe=unlabelled "$ip" "$port"
    check blocked "pod in another namespace -> $name" from_new_pod default probe=other "$ip" "$port"
  done
  echo "databases and platform"
  while read -r db host; do
    db_ip=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$host")
    check blocked "unlabelled pod in $app -> database $db" from_new_pod "$app" probe=unlabelled "$db_ip" 5432
    check blocked "pod in another namespace -> database $db" from_new_pod default probe=other "$db_ip" 5432
  done < <(jq -r '.databases[] | "\(.name) \(.host)"' <<<"$plan")
  check blocked "pod in another namespace -> git server" from_new_pod default probe=other "$git_ip" 9418
  return $failed
}

# Claude's own Kubernetes identity locally (D41, D71): a service account with the built-in `view` role (reads all
# but Secrets) and a kubeconfig for it in $state, which the platform repo's Kubernetes MCP server uses. For
# infra developers' Claude; an app developer's Claude keeps only the telemetry (AGENTS.md §3).
kubernetes_for_claude() {
  local file="$state/kubeconfig-claude" server ca token
  k -n kube-system create serviceaccount claude --dry-run=client -o yaml | k apply -f - >/dev/null
  k create clusterrolebinding claude-view --clusterrole=view --serviceaccount=kube-system:claude \
    --dry-run=client -o yaml | k apply -f - >/dev/null
  server=$(kubectl --kubeconfig "$kubeconfig" config view --minify -o jsonpath='{.clusters[0].cluster.server}')
  ca=$(kubectl --kubeconfig "$kubeconfig" config view --raw --minify -o jsonpath='{.clusters[0].cluster.certificate-authority-data}')
  token=$(k -n kube-system create token claude --duration=24h)
  rm -f "$file"
  kubectl config --kubeconfig "$file" set-cluster local --server="$server" >/dev/null
  kubectl config --kubeconfig "$file" set clusters.local.certificate-authority-data "$ca" >/dev/null
  kubectl config --kubeconfig "$file" set-credentials claude --token="$token" >/dev/null
  kubectl config --kubeconfig "$file" set-context claude --cluster=local --user=claude >/dev/null
  kubectl config --kubeconfig "$file" use-context claude >/dev/null
  chmod 600 "$file"
}

down() {
  kind delete cluster --name "$cluster" 2>/dev/null || true
  docker ps -aq --filter "label=platform.app=$app" | xargs -r docker rm -f >/dev/null
}

# Postgres outside the cluster (D61), on kind's Docker network, as Azure's Flexible Server is outside AKS. The
# platform creates the database and its roles (§9.2): local passwords here, Entra identities in Azure (D69).
# Its own log (connections, errors, slow statements) goes as JSON to $state/postgres/<host>, which the workers
# see at /src/.local/postgres and the collector reads.
database() { # name host
  local db=$1 host=$2 logs="$state/postgres/$2"
  rm -rf "$logs" && mkdir -p "$logs" && chmod 777 "$logs"
  docker run -d --name "$host" --label "platform.app=$app" --network kind -e POSTGRES_DB="$db" \
    -e POSTGRES_PASSWORD=local-only-superuser -v "$logs:/var/log/postgresql" "$POSTGRES_IMAGE" \
    postgres -c shared_preload_libraries=pg_stat_statements -c pg_stat_statements.track=all -c logging_collector=on -c log_destination=jsonlog -c log_directory=/var/log/postgresql \
    -c log_filename=postgresql.log -c log_rotation_age=0 -c log_connections=on -c log_disconnections=on \
    -c log_min_duration_statement=200 -c log_file_mode=0644 >/dev/null
  until docker exec "$host" pg_isready -U postgres -d "$db" >/dev/null 2>&1; do sleep 1; done
  sleep 2 # pg_isready answers before the init process has restarted the server
  until docker exec "$host" pg_isready -U postgres -d "$db" >/dev/null 2>&1; do sleep 1; done
  docker exec -i "$host" psql -q -U postgres -d "$db" -v ON_ERROR_STOP=1 <<SQL
CREATE ROLE ${db}_migrator LOGIN PASSWORD 'local-only-migrator';
CREATE ROLE ${db}_app LOGIN PASSWORD 'local-only-app';
CREATE ROLE ${db}_readonly LOGIN PASSWORD 'local-only-readonly';
CREATE SCHEMA $db AUTHORIZATION ${db}_migrator;
GRANT USAGE ON SCHEMA $db TO ${db}_app, ${db}_readonly;
ALTER DEFAULT PRIVILEGES FOR ROLE ${db}_migrator IN SCHEMA $db GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO ${db}_app;
ALTER DEFAULT PRIVILEGES FOR ROLE ${db}_migrator IN SCHEMA $db GRANT SELECT ON TABLES TO ${db}_readonly;
REVOKE CREATE ON SCHEMA public FROM PUBLIC;
-- Statistics (D64): per-query statistics, a monitor role for the collector (no data, only statistics), and
-- every query's statistics for the read-only role, which Claude's Postgres MCP uses (EXPLAIN, top queries).
CREATE EXTENSION pg_stat_statements;
CREATE ROLE ${db}_monitor LOGIN PASSWORD 'local-only-monitor' IN ROLE pg_monitor;
GRANT pg_read_all_stats TO ${db}_readonly;
-- The read-only role (developers, and Claude's Postgres MCP, D75) may EXPLAIN ANALYZE: its privileges allow only
-- SELECT, its transactions are read-only by default, and nothing runs longer than 30 seconds.
ALTER ROLE ${db}_readonly SET default_transaction_read_only = on;
ALTER ROLE ${db}_readonly SET statement_timeout = '30s';
SQL
  # The app's connection, as a Secret the rendered Deployment reads (Render.fs). Argo CD later adopts the
  # namespace (Cluster.fs), and leaves the Secret alone: it's not in git.
  k create namespace "$app" --dry-run=client -o yaml | k apply -f - >/dev/null
  # The collector's connection as the monitor role (one database for now; several need one receiver each).
  k create namespace observability --dry-run=client -o yaml | k apply -f - >/dev/null
  k -n observability create secret generic postgres-monitor --from-literal=endpoint="$host:5432" \
    --from-literal=username="${db}_monitor" --from-literal=password=local-only-monitor \
    --dry-run=client -o yaml | k apply -f - >/dev/null
  k -n "$app" create secret generic "$db-app" \
    --from-literal=connectionString="Host=$host;Port=5432;Database=$db;Username=${db}_app;Password=local-only-app" \
    --dry-run=client -o yaml | k apply -f - >/dev/null
}

# When the developer's machine reaches the internet only through a proxy (Claude's sandbox, D81, or a company
# proxy), the components that download from it (Argo CD's charts, Grafana's plugins) get it too: HTTPS only, so
# the cluster's own traffic, which is plain HTTP, never goes there. Without a proxy there is no ConfigMap, and the
# components' optional reference to it does nothing.
egress_proxy() {
  [ -n "${HTTPS_PROXY:-}" ] || return 0
  local address=${HTTPS_PROXY#*://} ns
  address=${address##*@} && address=${address%%/*}
  [[ ${address%:*} =~ ^[0-9.]+$ ]] ||
    { echo "The proxy must be given by IP address (it's allowed by address, D66): $address" >&2; exit 1; }
  for ns in argocd observability; do
    k create namespace "$ns" --dry-run=client -o yaml | k apply -f - >/dev/null
    k -n "$ns" create configmap platform-proxy --from-literal=HTTPS_PROXY="$HTTPS_PROXY" \
      --from-literal=NO_PROXY="${NO_PROXY:-}" --dry-run=client -o yaml | k apply -f - >/dev/null
    # Their network rules allow the internet on 443 only; the proxy listens elsewhere.
    k apply -f - >/dev/null <<EOF
apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata: { name: platform-proxy, namespace: $ns }
spec:
  endpointSelector: {}
  egress:
    - toCIDR: [ ${address%:*}/32 ]
      toPorts: [ { ports: [ { port: "${address##*:}", protocol: TCP } ] } ]
EOF
  done
}

up() {
  wait=10m
  mkdir -p "$state"
  step "Renderer image (Argo CD's plugin) and the app's plan"
  build_renderer >/dev/null
  read_plan

  step "Fresh cluster $cluster (Kubernetes ${KIND_NODE_IMAGE%%@*})"
  down
  # The Kubernetes API's audit policy (D71), mounted into the control-plane node.
  mkdir -p "$state/audit" && cp "$here/audit-policy.yaml" "$state/audit/policy.yaml"
  cat >"$state/kind.yaml" <<EOF
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
networking:
  disableDefaultCNI: true # Cilium instead, which enforces network rules
  apiServerPort: 9877 # fixed, next to the app and Grafana, so Claude's sandbox can be allowed exactly it (D80)
nodes:
  - role: control-plane
    image: $KIND_NODE_IMAGE
    # The API server writes an audit log, which the agent collector on this node reads (D71).
    kubeadmConfigPatches:
      - |
        kind: ClusterConfiguration
        apiServer:
          extraArgs:
            - { name: audit-policy-file, value: /etc/kubernetes/audit/policy.yaml }
            - { name: audit-log-path, value: /var/log/kubernetes/audit/audit.log }
            - { name: audit-log-maxsize, value: "50" }
            - { name: audit-log-maxbackup, value: "2" }
          extraVolumes:
            - { name: audit-policy, hostPath: /etc/kubernetes/audit, mountPath: /etc/kubernetes/audit, readOnly: true, pathType: Directory }
            - { name: audit-log, hostPath: /var/log/kubernetes/audit, mountPath: /var/log/kubernetes/audit, pathType: DirectoryOrCreate }
    extraMounts: [ { hostPath: "$state/audit", containerPath: /etc/kubernetes/audit, readOnly: true } ]
    extraPortMappings:
      - { containerPort: 30875, hostPort: 9875, listenAddress: 127.0.0.1 } # the app, through the gateway
      - { containerPort: 30876, hostPort: 9876, listenAddress: 127.0.0.1 } # Grafana
  # Two workers, so an app's two instances sit on different nodes (D57); the app's repo is mounted on both
  # for hot reload (D61) and for the git server's snapshots (D68).
  - role: worker
    image: $KIND_NODE_IMAGE
    extraMounts: [ { hostPath: "$app_repo", containerPath: /src, readOnly: true } ]
  - role: worker
    image: $KIND_NODE_IMAGE
    extraMounts: [ { hostPath: "$app_repo", containerPath: /src, readOnly: true } ]
EOF
  kind create cluster --name "$cluster" --config "$state/kind.yaml" --kubeconfig "$kubeconfig" --wait 0s
  join_kind

  step "Cilium $CILIUM_CHART_VERSION (the network; AKS brings its own)"
  h repo add cilium https://helm.cilium.io >/dev/null 2>&1 || true
  h repo update cilium >/dev/null
  # With the environment's networkFlows (D71): Hubble records the network's decisions. Dropped flows go to a file
  # on each node, which the agent collector reads; flow and drop counts per namespace go to Prometheus.
  hubble=$(jq -r .networkFlows <<<"$plan")
  cat >"$state/cilium.yaml" <<EOF
ipam: { mode: kubernetes }
operator: { replicas: 1 }
hubble:
  enabled: $hubble
  relay: { enabled: false }
  metrics:
    enabled: [ dns, drop, tcp, "flow:sourceContext=namespace;destinationContext=namespace", "policy:sourceContext=namespace;destinationContext=namespace" ]
    serviceAnnotations: { prometheus.io/scrape: "true", prometheus.io/port: "9965" }
  export:
    static:
      enabled: $hubble
      filePath: /var/run/cilium/hubble/events.log
      allowList: [ '{"verdict":["DROPPED"]}' ] # Hubble flow filters, as JSON
EOF
  installed kube-system h install cilium cilium/cilium --version "$CILIUM_CHART_VERSION" -n kube-system \
    -f "$state/cilium.yaml" --wait --timeout 3m
  k wait --for=condition=Ready nodes --all --timeout=5m >/dev/null

  step "Images: the renderer and each service's dev target (D61)"
  load_renderer "$renderer_image" >/dev/null
  service_images >/dev/null

  jq -r '.databases[] | "\(.name) \(.host)"' <<<"$plan" | while read -r db host; do
    step "Database $db at $host (Postgres outside the cluster)"
    database "$db" "$host"
  done

  step "Snapshots of the checkouts, served by the git server (D68)"
  app_commit=$(snapshot "$app_repo" "$app")
  k create namespace gitops >/dev/null
  k apply -f "$platform_root/components/gitops/local" >/dev/null
  k -n gitops rollout status deployment/git --timeout=5m >/dev/null

  step "Argo CD and its root application (D67)"
  egress_proxy
  # Installed from the package its digest pins (D65), checked here; Argo CD then manages it like any component.
  read -r repo chart version namespace digest <<<"$(render chart /platform argocd)"
  rm -rf "$state/charts" && mkdir -p "$state/charts"
  h pull "$chart" --repo "$repo" --version "$version" -d "$state/charts" >/dev/null
  [ "sha256:$(sha256 "$state"/charts/*.tgz)" = "$digest" ] ||
    { echo "Argo CD's chart $chart $version isn't the package components/argocd pins ($digest)" >&2; exit 1; }
  installed "$namespace" h install argocd "$state"/charts/*.tgz -n "$namespace" --create-namespace \
    -f "$platform_root/components/argocd/values.yaml" -f "$platform_root/components/argocd/values-local.yaml" \
    --wait --timeout 5m
  k apply -f - >/dev/null <<EOF
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: platform
  namespace: argocd
spec:
  project: default
  source:
    repoURL: git://git.gitops.svc.cluster.local/platform
    targetRevision: main
    path: .
    plugin:
      name: platform
      env:
        - { name: MODE, value: cluster }
        - { name: ENVIRONMENT, value: local }
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated: { prune: true, selfHeal: true }
EOF
  synced "$platform_commit" "$app_commit"
  grafana_for_claude
  kubernetes_for_claude

  step "Ready"
  echo "App:     http://localhost:9875"
  echo "Grafana: http://localhost:9876 (admin / local-only-admin; Claude reads as the service account 'claude')"
  echo "kubectl: kubectl --kubeconfig $kubeconfig"
}

# Builds each service's dev target and loads it into the cluster (the package list or the SDK may have
# changed); prints the services whose image the cluster didn't have yet. Code changes don't need this: they reach
# the pods by hot reload.
service_images() {
  local name image build loaded
  while read -r name image build; do
    docker build -q --provenance=false --target dev -t "$image" "$app_repo/$build" >/dev/null
    # kind loads only onto nodes that don't have this exact image, and says so.
    loaded=$(kind load docker-image "$image" --name "$cluster" 2>&1) || { echo "$loaded" >&2; exit 1; }
    if [[ $loaded == *"not yet present"* ]]; then echo "$name"; fi
  done < <(jq -r '.services[] | "\(.name) \(.image) \(.build)"' <<<"$plan")
}

sync() {
  # The renderer first: the plan comes from it, and a changed platform.yaml may need the new one.
  local renderer
  renderer=$(build_renderer)
  read_plan
  join_kind
  egress_proxy # its port may have changed
  if [ "$renderer" = changed ]; then
    load_renderer "$renderer_image" >/dev/null
    k -n argocd rollout restart deployment/argocd-repo-server >/dev/null
    k -n argocd rollout status deployment/argocd-repo-server --timeout=5m >/dev/null
  fi
  for name in $(service_images); do k -n "$app" rollout restart "deployment/$name" >/dev/null; done
  synced "$platform_commit" "$(snapshot "$app_repo" "$app")"
  grafana_for_claude
  kubernetes_for_claude
}

case "$command" in
  up) up ;;
  sync) sync ;;
  test) build_renderer >/dev/null && read_plan && join_kind && network_test ;;
  down) build_renderer >/dev/null && read_plan && down ;;
  *) echo "$usage" >&2; exit 2 ;;
esac
